# Maintainer: shed <noreply@shed.run>
# Generated by .github/workflows/publish-aur.yml — edit the template, not the
# copy in the AUR repository.
pkgname=shed-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="CLI for deploying and sharing small software"
arch=('x86_64' 'aarch64')
url="https://shed.codes"
license=('MIT')
provides=('shed')
conflicts=('shed')
source_x86_64=("https://github.com/shed-sh/cli/releases/download/v${pkgver}/shed-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("https://github.com/shed-sh/cli/releases/download/v${pkgver}/shed-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
	case "$CARCH" in
	x86_64) _triple=x86_64-unknown-linux-gnu ;;
	aarch64) _triple=aarch64-unknown-linux-gnu ;;
	esac
	install -Dm755 "${srcdir}/shed-${_triple}/shed" "${pkgdir}/usr/bin/shed"
}
