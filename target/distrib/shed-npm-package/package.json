    },
    "x86_64-apple-darwin": {
      "artifactName": "shed-x86_64-apple-darwin.tar.xz",
      "bins": {
        "shed": "shed"
      },
      "zipExt": ".tar.xz"
    },
    "x86_64-unknown-linux-gnu": {
      "artifactName": "shed-x86_64-unknown-linux-gnu.tar.xz",
      "bins": {
        "shed": "shed"
      },
      "zipExt": ".tar.xz"
    }
  },
  "version": "0.1.0",
